{
  "name": "@xvendas/robot",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "login": "tsx src/login.ts",
    "inspect": "tsx src/inspect.ts",
    "inspect:credit": "tsx src/inspectCredit.ts",
    "typecheck": "tsc --noEmit",
    "login:auto": "tsx src/loginAuto.ts",
    "test:product-parser": "node --experimental-strip-types --test tests/productSearch.test.mjs",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "playwright": "^1.55.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
